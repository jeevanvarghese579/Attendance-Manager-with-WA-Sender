rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticatedUser() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function attendanceManagerAppId() {
      return '1:379503088311:web:e046f96ed629ffd4133332';
    }

    function ascensionFirebaseAppId() {
      return '1:379503088311:web:7b5117cc3447eded133332';
    }

    function labMetricsFirebaseAppId() {
      return '1:379503088311:web:b37328f071189e18133332';
    }

    function hasCanonicalAppAccess(uid, appId) {
      return request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/accessUsers/$(uid))
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.active == true
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.apps[appId] == true
        && (
          !('appExpirations' in get(/databases/$(database)/documents/accessUsers/$(uid)).data)
          || !(appId in get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations)
          || get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations[appId] > request.time
        )
        && exists(/databases/$(database)/documents/appRegistry/$(appId))
        && get(/databases/$(database)/documents/appRegistry/$(appId)).data.active == true;
    }

    function hasCollageMakerAccess(uid) {
      return hasCanonicalAppAccess(uid, '1:379503088311:web:6a63dfcd8523e9f8133332');
    }

    function hasAttendanceManagerAccess(uid) {
      return hasCanonicalAppAccess(uid, attendanceManagerAppId());
    }

    function hasLabMetricsAccess(uid) {
      return isAuthenticatedUser()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/accessUsers/$(uid))
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.active == true
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.apps[labMetricsFirebaseAppId()] == true
        && (
          !('appExpirations' in get(/databases/$(database)/documents/accessUsers/$(uid)).data)
          || !(labMetricsFirebaseAppId() in get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations)
          || get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations[labMetricsFirebaseAppId()] > request.time
        )
        && exists(/databases/$(database)/documents/appRegistry/$(labMetricsFirebaseAppId()))
        && get(/databases/$(database)/documents/appRegistry/$(labMetricsFirebaseAppId())).data.active == true;
    }

    function hasAscensionManagerAccess() {
      return isAuthenticatedUser()
        && exists(/databases/$(database)/documents/appRegistry/$(ascensionFirebaseAppId()))
        && get(/databases/$(database)/documents/appRegistry/$(ascensionFirebaseAppId())).data.active == true
        && (
          (
            exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.active == true
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.apps[ascensionFirebaseAppId()] == true
            && (
              !('appExpirations' in get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data)
              || !(ascensionFirebaseAppId() in get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.appExpirations)
              || get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.appExpirations[ascensionFirebaseAppId()] > request.time
            )
          )
          || (
            !exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
            && exists(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower())).data.active == true
          )
        );
    }

    // Existing Collage Maker data remains protected by its own app permission.
    match /users/{uid}/{document=**} {
      allow read, write: if hasCollageMakerAccess(uid);
    }

    // Preserve the deployed LabMetrics permissions on its four app-owned paths.
    match /users/{uid}/students/{document=**} {
      allow read, write: if hasLabMetricsAccess(uid);
    }
    match /users/{uid}/experiments/{document=**} {
      allow read, write: if hasLabMetricsAccess(uid);
    }
    match /users/{uid}/grades/{document=**} {
      allow read, write: if hasLabMetricsAccess(uid);
    }
    match /users/{uid}/settings/{document=**} {
      allow read, write: if hasLabMetricsAccess(uid);
    }

    // Attendance Manager has an app-specific root to prevent cross-app access.
    match /attendanceManagerUsers/{uid}/{document=**} {
      allow read, write: if hasAttendanceManagerAccess(uid);
    }

    match /invitedEmails/{email} {
      allow get: if isAuthenticatedUser() && email == request.auth.token.email.lower();
      allow list, create, update, delete: if false;
    }

    match /ascensionManagerUsers/{userId} {
      allow read, write: if hasAscensionManagerAccess() && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if hasAscensionManagerAccess() && request.auth.uid == userId;
      }
    }

    // Access Manager collections are callable-function-only. The Admin SDK
    // bypasses these client rules after enforcing identity server-side.
    match /admins/{document=**} { allow read, write: if false; }
    match /adminInvites/{document=**} { allow read, write: if false; }
    match /accessUsers/{document=**} { allow read, write: if false; }
    match /accessInvites/{document=**} { allow read, write: if false; }
    match /appRegistry/{document=**} { allow read, write: if false; }
    match /accessRequests/{document=**} { allow read, write: if false; }
    match /accessRequestKeys/{document=**} { allow read, write: if false; }
    match /mail/{document=**} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
